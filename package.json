{
  "name": "roster",
  "version": "0.1.0-alpha.1",
  "description": "A local-first desktop messenger for persistent AI workers.",
  "author": "Roster contributors",
  "desktopName": "roster",
  "private": false,
  "license": "MIT",
  "homepage": "https://github.com/Vaibhav701161/Roster#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaibhav701161/Roster.git"
  },
  "bugs": {
    "url": "https://github.com/Vaibhav701161/Roster/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "dev:desktop": "node scripts/dev.mjs",
    "start:desktop": "electron .",
    "serve": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:ui": "node tests/ui-qa.mjs",
    "test:webmcp": "node tests/webmcp.mjs",
    "test:real-work": "node tests/real-work.mjs",
    "format": "prettier --write src server tests scripts electron docs *.json *.ts *.html *.md",
    "format:check": "prettier --check src server tests scripts electron docs *.json *.ts *.html *.md",
    "lint": "tsc --noEmit && node --check server/index.mjs && node --check server/runtime.mjs",
    "package": "npm run package:win",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:win:dir": "npm run build && electron-builder --win dir",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:mac": "npm run build && electron-builder --mac dmg zip",
    "package:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64",
    "package:mac:x64": "npm run build && electron-builder --mac dmg zip --x64"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@openai/codex": "0.154.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.54.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "app.roster.desktop",
    "productName": "Roster",
    "icon": "assets/roster-icon.svg",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "assets/roster-icon.svg",
      "darkModeSupport": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
